{
  "datasets": [
    {
      "name": "ds_latest",
      "displayName": "Indicadores mais recentes",
      "queryLines": [
        "SELECT codigo_serie, indicador, data, valor, unidade FROM latest_indicators ORDER BY codigo_serie"
      ]
    },
    {
      "name": "ds_features",
      "displayName": "Séries mensais",
      "queryLines": [
        "SELECT mes, meta_selic, ipca_mensal, dolar_medio, ipca_12_meses FROM economic_features ORDER BY mes"
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Resumo de qualidade",
      "queryLines": [
        "SELECT b.total AS bronze, s.total AS silver, r.total AS rejeitados, ",
        "b.total - s.total - r.total AS duplicidades_removidas, ",
        "CASE WHEN b.total = 0 THEN NULL ELSE CAST(s.total AS DOUBLE) / b.total END AS aproveitamento ",
        "FROM (SELECT COUNT(*) AS total FROM workspace.bcb_bronze.sgs_raw) b ",
        "CROSS JOIN (SELECT COUNT(*) AS total FROM workspace.bcb_silver.economic_indicators) s ",
        "CROSS JOIN (SELECT COUNT(*) AS total FROM workspace.bcb_silver.data_quality) r"
      ]
    },
    {
      "name": "ds_distribution",
      "displayName": "Registros por indicador",
      "queryLines": [
        "SELECT indicador, COUNT(*) AS registros FROM workspace.bcb_silver.economic_indicators GROUP BY indicador ORDER BY indicador"
      ]
    },
    {
      "name": "ds_freshness",
      "displayName": "Atualização por indicador",
      "queryLines": [
        "SELECT indicador, frequencia, unidade, MAX(data) AS ultima_observacao, MAX(extraido_em) AS ultima_extracao, ",
        "DATEDIFF(CURRENT_DATE(), MAX(data)) AS dias_desde_observacao ",
        "FROM workspace.bcb_silver.economic_indicators GROUP BY indicador, frequencia, unidade ORDER BY indicador"
      ]
    },
    {
      "name": "ds_sel",
      "displayName": "Último valor SGS 432",
      "queryLines": [
        "SELECT valor, data, unidade FROM latest_indicators WHERE codigo_serie = 432"
      ]
    },
    {
      "name": "ds_ipca",
      "displayName": "Último valor SGS 433",
      "queryLines": [
        "SELECT valor, data, unidade FROM latest_indicators WHERE codigo_serie = 433"
      ]
    },
    {
      "name": "ds_dolar",
      "displayName": "Último valor SGS 1",
      "queryLines": [
        "SELECT valor, data, unidade FROM latest_indicators WHERE codigo_serie = 1"
      ]
    },
    {
      "name": "ds_ipca12",
      "displayName": "Último valor SGS 13522",
      "queryLines": [
        "SELECT valor, data, unidade FROM latest_indicators WHERE codigo_serie = 13522"
      ]
    }
  ],
